{
  "name": "duck-fashion-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Duck Fashion demo stock API (SQLite, Node.js). Serves product, inventory, stock-adjustment, member bonus (balance, redeemables, Bonus-as-Cash) endpoints plus whitelisted product photos.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --import tsx server/capsule-api.ts",
    "seed": "node --import tsx server/seed-capsule.ts",
    "seed:bonus": "node --import tsx server/bonus-seed.ts",
    "seed:glacier": "node --import tsx server/glacier-seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 server/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "libphonenumber-js": "^1.11.20",
    "tsx": "^4.19.0",
    "zod": "^3.25.76"
  }
}
