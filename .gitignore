# Dependencies (reinstalled with npm install / npm ci)
node_modules/

# Live secrets — generated on each machine by deploy/create-config.sh
.local-duck/live-connection.json
.local-duck/live-connection.json.tmp
.local-duck/live-connection.*.json
.local-duck/*customers*.json
.local-duck/pi-connection.json
.local-duck/managers.json
.local-duck/*locations*.json
deploy/private-crm.env
deploy/.env

# Live database — stock adjustments happen on the Pi and must never be
# overwritten by a deploy. A fresh clone recreates it with: npm run seed
data/duck-fashion.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm

# Logs and editor noise
*.log
*.swp
.DS_Store

# Private runtime/operator files
data/glacier-icerink.sqlite
.local-glacier/
.local-duck/admin-connection.json
.local-duck/remote-*.json
*.sqlite.tmp
.local-duck/backups/
data/*.sqlite.sha256
# Customer datasets and database backups are private, including scrubbed exports.
# Tests generate synthetic Glacier fixtures in temporary directories.
*.bak
*.mdf
*.ldf
*.dump
*.sqlite
*.sqlite-*
*.sqlite.tmp
*.db
*.tsv
*.tsv.gz
*.csv
*.csv.gz
data/glacier-*
